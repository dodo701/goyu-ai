{
  "name": "goyu-ai",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "pages:deploy": "next build && wrangler pages deploy out --project-name goyu-ai",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "20.16.10",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.20",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "5.6.3",
    "wrangler": "^4.153.0"
  }
}
